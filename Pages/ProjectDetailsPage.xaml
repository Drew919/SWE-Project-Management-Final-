<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ArchonPM.Pages.ProjectDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ArchonPM.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="PageTitle" Text="Project Details" FontSize="30" FontWeight="SemiBold" VerticalAlignment="Center"/>

        <TextBlock
            x:Name="ErrorText"
            Grid.Row="1"
            Margin="0,12,0,0"
            Foreground="DarkRed"
            TextWrapping="WrapWholeWords"
            Visibility="Collapsed"/>

        <StackPanel x:Name="ActingAsPanel" Grid.Row="2" Margin="0,16,0,8" Spacing="4" Visibility="Collapsed">
            <TextBlock Text="Acting as (course demo — no login)" FontSize="12" Opacity="0.7"/>
            <ComboBox
                x:Name="ActingAsBox"
                MinWidth="280"
                SelectionChanged="ActingAsBox_SelectionChanged"/>
        </StackPanel>

        <Pivot x:Name="DetailsPivot" Grid.Row="3" Visibility="Collapsed" SelectionChanged="DetailsPivot_SelectionChanged">
            <PivotItem Header="Overview">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,0,0">
                    <StackPanel Spacing="12" MaxWidth="720" HorizontalAlignment="Left">
                        <TextBlock x:Name="OverviewName" FontSize="22" FontWeight="SemiBold" TextWrapping="WrapWholeWords"/>
                        <TextBlock x:Name="OverviewOwner" FontSize="14" TextWrapping="WrapWholeWords"/>
                        <TextBlock x:Name="OverviewStatus" FontSize="14" FontWeight="SemiBold" TextWrapping="WrapWholeWords"/>
                        <TextBlock x:Name="OverviewDescription" FontSize="14" TextWrapping="WrapWholeWords"/>
                        <Button x:Name="EditProjectButton" Content="Edit Project" Click="EditProjectButton_Click" HorizontalAlignment="Left"/>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <PivotItem Header="Requirements">
                <Grid Padding="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Button x:Name="AddRequirementButton" Content="Add Requirement" Click="AddRequirementButton_Click" Margin="0,0,0,12"/>
                    <TextBlock
                        x:Name="RequirementsEmptyText"
                        Grid.Row="1"
                        Text="No requirements yet."
                        Opacity="0.7"
                        Visibility="Collapsed"/>
                    <ListView
                        x:Name="RequirementsList"
                        Grid.Row="1"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:RequirementItem">
                                <Grid Padding="0,8" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextWrapping="WrapWholeWords"/>
                                        <TextBlock Text="{x:Bind Category}" FontSize="12" Opacity="0.75"/>
                                        <TextBlock Text="{x:Bind Description}" FontSize="14" TextWrapping="WrapWholeWords"/>
                                    </StackPanel>
                                    <Button
                                        Grid.Column="1"
                                        Content="Edit"
                                        Tag="{x:Bind ID}"
                                        Visibility="{x:Bind EditVisibility}"
                                        Click="EditRequirementButton_Click"
                                        VerticalAlignment="Top"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </PivotItem>

            <PivotItem Header="People and Roles">
                <Grid Padding="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Button x:Name="AddMemberButton" Content="Add Person" Click="AddMemberButton_Click" Margin="0,0,0,12"/>
                    <TextBlock
                        x:Name="MembersEmptyText"
                        Grid.Row="1"
                        Text="No members yet."
                        Opacity="0.7"
                        Visibility="Collapsed"/>
                    <ListView
                        x:Name="MembersList"
                        Grid.Row="1"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:MemberItem">
                                <Grid Padding="0,8" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextWrapping="WrapWholeWords"/>
                                        <TextBlock Text="{x:Bind EmailDisplay}" FontSize="12" Opacity="0.75" TextWrapping="WrapWholeWords"/>
                                        <TextBlock Text="{x:Bind RoleDisplay}" FontSize="14" FontWeight="SemiBold" TextWrapping="WrapWholeWords"/>
                                    </StackPanel>
                                    <Button
                                        Grid.Column="1"
                                        Content="Edit Role"
                                        Tag="{x:Bind ID}"
                                        Visibility="{x:Bind EditVisibility}"
                                        Click="EditRoleButton_Click"
                                        VerticalAlignment="Top"/>
                                    <Button
                                        Grid.Column="2"
                                        Content="Remove"
                                        Tag="{x:Bind ID}"
                                        Visibility="{x:Bind RemoveVisibility}"
                                        Click="RemoveMemberButton_Click"
                                        VerticalAlignment="Top"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </PivotItem>
        </Pivot>
    </Grid>
</Page>
