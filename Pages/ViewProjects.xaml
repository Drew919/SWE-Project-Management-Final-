<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ArchonPM.Pages.ViewProjects"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:objects="using:ArchonPM.Objects"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock
            Text="Projects"
            FontSize="30"
            FontWeight="SemiBold"
            Margin="0,0,0,12"/>

        <TextBlock
            x:Name="EmptyStateText"
            Grid.Row="1"
            Text="No projects yet. Use New Project to create one."
            FontSize="16"
            Opacity="0.7"
            VerticalAlignment="Top"
            Visibility="Collapsed"/>

        <ListView
            x:Name="ProjectsList"
            Grid.Row="1"
            SelectionMode="None"
            IsItemClickEnabled="False">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="objects:Project">
                    <StackPanel Spacing="4" Padding="0,8">
                        <TextBlock
                            Text="{x:Bind Name}"
                            FontSize="18"
                            FontWeight="SemiBold"
                            TextWrapping="WrapWholeWords"/>
                        <TextBlock FontSize="14" Opacity="0.8" TextWrapping="WrapWholeWords">
                            <Run Text="Owner: "/><Run Text="{x:Bind Owner}"/>
                        </TextBlock>
                        <TextBlock
                            Text="{x:Bind Description}"
                            FontSize="14"
                            TextWrapping="WrapWholeWords"/>
                        <TextBlock FontSize="14" FontWeight="SemiBold" TextWrapping="WrapWholeWords">
                            <Run Text="Status: "/><Run Text="{x:Bind Status}"/>
                        </TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
